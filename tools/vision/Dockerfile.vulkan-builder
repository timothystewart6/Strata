FROM ubuntu:24.04
ARG LLAMA_CPP_COMMIT=3cf03257f219afbe7334045ff7c6a06ac68c627d
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates cmake glslang-tools libvulkan-dev ninja-build python3 unzip wget \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . /src/
RUN mkdir -p /src/third_party \
 && wget -q "https://github.com/ggml-org/llama.cpp/archive/${LLAMA_CPP_COMMIT}.zip" -O /tmp/llama.cpp.zip \
 && unzip -q /tmp/llama.cpp.zip -d /tmp \
 && mv "/tmp/llama.cpp-${LLAMA_CPP_COMMIT}" /src/third_party/llama.cpp \
 && cmake -G Ninja -S tools/vision -B /build -DCMAKE_BUILD_TYPE=Release \
      -DLLAMA_DIR=/src/third_party/llama.cpp -DSTRATA_VISION_VULKAN=ON -DSTRATA_PORTABLE=ON \
 && cmake --build /build --target strata-vision -j "$(nproc)" \
 && mkdir -p /out \
 && cp /build/bin/strata-vision-vulkan /out/strata-vision-vulkan
CMD ["/bin/true"]
